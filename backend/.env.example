# Copy this file to `.env` in the `backend/` folder and fill in real
# values for your environment. Never commit the real `.env` file.

# SQLAlchemy database URL. Defaults to a local SQLite file if unset.
DATABASE_URL=sqlite:///./smart_blackboard.db

# Secret key used to sign JWT access tokens.
# Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-long-random-secret

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=180

# Code a guest must provide to self-register as a teacher.
TEACHER_REGISTER_CODE=replace-with-your-own-code

# Comma-separated list of origins allowed to call the API / connect
# to the WebSocket endpoint.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
