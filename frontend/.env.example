# Copy this file to `.env` in the `frontend/` folder if you need to
# point the app at a backend that isn't running on the default local
# address. Vite only exposes variables prefixed with VITE_.

# Base URL of the FastAPI backend (HTTP).
VITE_API_URL=http://127.0.0.1:8000

# Base URL of the WebSocket endpoint. If unset, it's derived from
# VITE_API_URL by swapping the http/https scheme for ws/wss.
# VITE_WS_URL=ws://127.0.0.1:8000
